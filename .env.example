# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 깃에 올라가지 않는다.
# 서버리스 함수(api/)에서만 읽는다. VITE_ 접두사를 붙이면 브라우저에 그대로 노출되니 붙이지 말 것.

# 공공데이터포털(data.go.kr) 일반 인증키 — 표준데이터 조회용
DATA_GO_KR_KEY=

# 역지오코딩 키 (VWorld 또는 카카오 중 쓰는 쪽만 채운다)
VWORLD_KEY=
# 브이월드 키에 등록한 서비스 URL (예: https://xxx.vercel.app). 키 오류가 나면 채운다.
VWORLD_DOMAIN=
KAKAO_REST_KEY=

# 사진 판독(번호판·장면) 비전 AI 키 — 쓰는 제공자 하나만 채운다
VISION_PROVIDER=
VISION_API_KEY=
# 비우면 gemini-3.5-flash. 붐비거나 없어지면 api/vision.ts 의 대체 모델로 넘어간다
VISION_MODEL=

# 선택: 카카오 지도 JavaScript 키 (공개 클라이언트 키, 등록 도메인 제한 필수).
# 서버 비밀인 KAKAO_REST_KEY/VISION_API_KEY를 여기에 넣지 않는다.
# 미설정·연결 실패 시 기존 VWorld 지도를 쓰고 수동 입력·사진 보관을 유지한다.
VITE_KAKAO_MAP_JS_KEY=
